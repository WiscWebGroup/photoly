# PostgreSQL passwords are separate values, never interpolated into URLs.
POSTGRES_ADMIN_PASSWORD=replaceWithRandomRootPassword
POSTGRES_APP_PASSWORD=replaceWithRandomApplicationPassword
POSTGRES_MIGRATION_PASSWORD=replaceWithDifferentRandomMigrationPassword
# Redis password enters a URL; use URL-safe alphanumeric characters.
REDIS_PASSWORD=replaceWithRandomRedisPassword
ADMIN_EMAIL=admin@a.com
ADMIN_PASSWORD=replaceWithRandomAdminPassword
PUBLIC_BASE_URL=http://localhost:8384
TIMEZONE=America/New_York
MAX_CONTENT_LENGTH=629145600

# Internal AI service credentials; use different random values.
AI_INFERENCE_TOKEN=replaceWithRandomInferenceToken
AI_CONTROL_TOKEN=replaceWithDifferentRandomControlToken
