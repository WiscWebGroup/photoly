# PostgreSQL passwords are separate values, never interpolated into URLs.
POSTGRES_ADMIN_PASSWORD=replaceWithRandomRootPassword
POSTGRES_APP_PASSWORD=replaceWithRandomApplicationPassword
POSTGRES_MIGRATION_PASSWORD=replaceWithDifferentRandomMigrationPassword
ADMIN_EMAIL=admin@a.com
ADMIN_PASSWORD=replaceWithRandomAdminPassword
PUBLIC_BASE_URL=http://localhost:8384
TIMEZONE=America/New_York
MAX_CONTENT_LENGTH=629145600

# Background imports
UPLOAD_ZIP_MAX_BYTES=50000000000
UPLOAD_DISK_RESERVE_BYTES=536870912
# UPLOAD_TEMP_HOURS=24
# UPLOAD_HISTORY_DAYS=30

# Media conversion and optional administrator-enabled Online Download
# ONLINE_DOWNLOAD_MAX_BYTES=52428800
# ONLINE_DOWNLOAD_CONNECT_TIMEOUT=5
# ONLINE_DOWNLOAD_TIMEOUT=60
# MEDIA_PROCESS_TIMEOUT=60

# Required before users can save their personal S3 credentials in Storage settings:
# they are encrypted at rest with this key. Losing or changing it makes saved credentials unreadable.
# STORAGE_SECRET_KEY=replaceWithLongRandomString

# With remote storage, files fetched back to local disk are evicted after this long unused
# (Go duration, default 24h, 0 = keep forever).
# STORAGE_CACHE_TTL=24h

# Automatic local directory synchronization (Go duration).
# STORAGE_SCAN_INTERVAL=60s

# External sources: allow-root IDs, labels and existing container paths (default: none).
# STORAGE_LOCAL_ROOTS=[{"id":"nas","name":"NAS","path":"/mnt/nas"}]
# Exact private/Docker WebDAV origins; public HTTP/HTTPS requires no entry.
# STORAGE_WEBDAV_ALLOWED_HOSTS=http://nextcloud,https://nas.internal:8443
# Optional PEM CA bundle for private HTTPS; mount it read-only in the container.
# STORAGE_WEBDAV_CA_FILE=/etc/photoly/private-ca.pem
# See docs/external-storage.md for safe Docker bind-mount examples.

# Comma-separated SMB server names/IPs allowed to access private networks (TCP 445).
STORAGE_SMB_ALLOWED_HOSTS=
